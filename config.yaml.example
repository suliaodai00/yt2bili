# yt2bili 配置文件示例（推荐配置：8核/12G 内存提速方案）
# 使用方式：cp config.yaml.example config.yaml 后按需修改

# ---- 翻译引擎 ----
# 本地 Ollama（免费无限，推荐）或 gemini（免费API，有限额）
translation_engine: ollama

# Ollama 服务地址（本机默认）
ollama_url: http://127.0.0.1:11434

# 翻译模型：
#   qwen2.5:7b  约5GB，8核CPU较慢
#   qwen2.5:3b  约2GB，速度快约2.5~3倍，字幕翻译足够（推荐）
ollama_model: qwen2.5:3b

# 并发翻译路数（需 Ollama 服务端 OLLAMA_NUM_PARALLEL >= 此值才真正并行）
# 8核/12G 配 qwen2.5:3b 建议 3；若仍用 7b 请保持 1（防内存溢出）
ollama_concurrency: 3

# 每批字幕条数，CPU 机器建议 16
ollama_batch_size: 16

# Gemini 备用引擎（不使用可留空）
gemini_api_key: ""
gemini_model: gemini-2.5-flash

# ---- 下载 ----
# 若需代理下载 YouTube，填如 http://127.0.0.1:7890，留空则直连
proxy: ""

# ---- 上传 ----
bilibili:
  tid: 171   # 默认分区：171=科技
