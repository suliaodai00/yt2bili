# yt2bili 配置文件示例
# 使用方式：cp config.yaml.example config.yaml 后按需修改

# ---- 翻译引擎 ----
# 本地 Ollama（免费无限，推荐）或 gemini（免费API，有限额）
translation_engine: ollama

# Ollama 服务地址（本机默认）
ollama_url: http://127.0.0.1:11434

# 翻译模型
ollama_model: qwen2.5:7b

# 并发翻译路数
ollama_concurrency: 3

# 每批字幕条数
ollama_batch_size: 16

# Gemini 备用引擎
gemini_api_key: ""
gemini_model: gemini-2.5-flash

# ---- YouTube 统一认证与下载策略 ----
youtube:
  client: mweb
  browser: firefox
  browser_profile: /opt/yt2bili/data/youtube-firefox
  cookies_file: /opt/yt2bili/youtube_cookies.txt
  pot_provider_url: http://127.0.0.1:4416
  sleep_requests: 5
  sleep_interval: 5
  max_sleep_interval: 10
  retries: 2

# ---- 下载代理 (兼容旧格式) ----
proxy: "http://127.0.0.1:1080"

# ---- 上传 ----
bilibili:
  tid: 171   # 默认分区：171=科技
telegram_bot_token: ""
